<resources>
    <!-- Explicitly opaque: on some firmware DeviceDefault comes out translucent and the TV app keeps running
         under Home (cleanyourtv PROMPT.md). -->
    <style name="Home" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSwipeToDismiss">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:colorAccent">#FAFAFA</item>
    </style>
</resources>
